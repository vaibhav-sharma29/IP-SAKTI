# ═══════════════════════════════════════════════════════════
#  IP-SAKTI Backend — Environment Variables
#  Copy this file to .env and fill in your values
#  NEVER commit .env to git
# ═══════════════════════════════════════════════════════════

# ── Google Gemini API (FREE tier — 1M tokens/day) ───────────
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Bhashini API — Hindi translation (Govt of India FREE) ───
# Register: https://bhashini.gov.in/ulca/search
BHASHINI_API_KEY=your_bhashini_api_key_here
BHASHINI_USER_ID=your_bhashini_user_id_here

# ── Database — PostgreSQL ────────────────────────────────────
# Local development:
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/ipsakti

# AWS RDS (production) — replace with your RDS endpoint:
# DATABASE_URL=postgresql+asyncpg://ipsakti_user:StrongPass123@ipsakti-db.xxxxxxxx.ap-south-1.rds.amazonaws.com:5432/ipsakti

# ── ChromaDB vector store path ───────────────────────────────
CHROMA_DB_PATH=./chroma_db

# ── App Settings ─────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
